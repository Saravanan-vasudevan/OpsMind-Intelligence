# Copy to .env and fill in. Never commit .env.

POSTGRES_DB=opsmind
POSTGRES_USER=opsmind
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5432

# Backend
JWT_SECRET=replace_with_a_random_string_of_at_least_32_characters
# true when served over HTTPS
JWT_COOKIE_SECURE=false
# loads clearly-labelled SYNTHETIC demo data on an empty database
SEED_DEMO_DATA=true
SWAGGER_ENABLED=true
BACKEND_PORT=8080
FRONTEND_PORT=3000

# Shared secret between the API and the Python intelligence service (V2). Generate: python -c "import secrets;print(secrets.token_urlsafe(32))"
INTERNAL_API_KEY=replace_with_a_random_string_of_at_least_32_characters

# Later versions (V3, not used yet)
GEMINI_API_KEY=
# Free-tier model names change; check Google AI Studio for the current Flash model
GEMINI_MODEL=
